{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/camadas/:shareId", "destination": "/?camada=:shareId" },
    { "source": "/as-brabas/camadas/:shareId", "destination": "/as-brabas?camada=:shareId" },
    { "source": "/camadas/(.*)", "destination": "/" },
    { "source": "/as-brabas/camadas/(.*)", "destination": "/as-brabas" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
